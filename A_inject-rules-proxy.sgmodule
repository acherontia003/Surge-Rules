#!name=Rule Injector - Proxy (Surge 6.8+)
#!desc=由 Surge 独立按需注入规则，适用于策略组名称为 Proxy 的配置。
#!category=Injector
#!system=mac

[Rule]
PROCESS-NAME,/Applications/Muse.app/,Proxy
PROCESS-NAME,/Applications/ChatGPT.app/,PROXY
PROCESS-NAME,/Applications/UURemote.app/,DIRECT
RULE-SET,https://raw.githubusercontent.com/acherontia003/Surge-Rules/main/inject-direct-rules.list,DIRECT,update-interval=172800
RULE-SET,https://raw.githubusercontent.com/acherontia003/Surge-Rules/main/inject-rules.list,Proxy,update-interval=172800
